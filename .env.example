# Nur auf dem Server (Vercel → Settings → Environment Variables), niemals ins Repo.
ANTHROPIC_API_KEY=
# Selbst ausgedachter Code; die App fragt einmal danach, bevor sie die KI nutzt.
APP_ACCESS_CODE=
# Optional, Standard: claude-opus-5-5
CLAUDE_MODEL=
# Konten (optional, siehe README). Die VITE_-Werte landen im Browser, das ist so gewollt.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Nur Server, niemals ins Repo
SUPABASE_SERVICE_KEY=
